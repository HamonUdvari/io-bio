---
// PREVIEW — full-text search page (Pagefind).
// ----------------------------------------------------------------------------
// A deliberately minimal, self-contained page so we can see the search
// working end-to-end before deciding on the final UI. It uses Pagefind's
// built-in default UI (search box + ranked results + auto snippets +
// highlighting) with almost no custom code, so the whole thing is easy to
// restyle or replace later.
//
// The index + the UI bundle (dist/pagefind/*) are produced AFTER `astro build`
// by the Pagefind CLI — see `build:search` in package.json and the
// "Build Pagefind search index" step in .github/workflows/deploy.yml. They do
// not exist during `astro dev`, so test locally with:
//     pnpm run build:search && pnpm run preview
import Layout from "@layouts/Layout.astro";

// Base path, normalised to exactly one trailing slash (may be "/io-bio",
// "/io-bio/", or "/" in production). Everything Pagefind loads and links to is
// derived from this — the one static-site gotcha for a subpath deployment.
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout
  title="Search"
  description="Search the full text of every IO BIO biography."
>
  {/* Pagefind's default-UI stylesheet, served from the built bundle. */}
  <link rel="stylesheet" href={`${BASE}pagefind/pagefind-ui.css`} />

  <div class="search-page mx-auto w-full max-w-[900px] px-6 py-16">
    <h1 class="text-h2 mb-2">Search the biographies</h1>
    <p class="mb-8 opacity-70">
      Search the full text of every entry — including the Archives, Publications
      and Literature at the end of each biography.
    </p>

    {/* Pagefind injects the search box + results inside this container. */}
    <div id="search"></div>
  </div>

  {
    /* Load the default-UI bundle, then initialise it. Both scripts are `is:inline`
      so Astro leaves them untouched — the referenced files are generated by the
      Pagefind CLI post-build and live at `${BASE}pagefind/`, not in the source. */
  }
  <script is:inline src={`${BASE}pagefind/pagefind-ui.js`}></script>
  <script is:inline define:vars={{ base: BASE }}>
    window.addEventListener("DOMContentLoaded", () => {
      // Prefix result links with the site base path. Pagefind records URLs
      // relative to the indexed dist/ root (e.g. "/entries/<slug>/"), but the
      // site is served under `base` (e.g. "/io-bio/"), so links need the prefix.
      const prefix = (u) => {
        if (!u) return u;
        if (base === "/" || u.startsWith(base)) return u;
        return base.replace(/\/$/, "") + u;
      };
      new PagefindUI({
        element: "#search",
        // Point the bundle at the base-prefixed path (loads pagefind.js + the
        // index chunks); don't rely on script-URL auto-detection under a subpath.
        bundlePath: `${base}pagefind/`,
        showSubResults: true,
        showImages: false,
        processResult: (result) => {
          if (result.url) result.url = prefix(result.url);
          if (Array.isArray(result.sub_results)) {
            result.sub_results.forEach((s) => {
              if (s.url) s.url = prefix(s.url);
            });
          }
          return result;
        },
      });
    });
  </script>

  {
    /* Light theming so the default UI reads on the dark site. Global (not scoped)
      because Pagefind injects its markup at runtime — scoped selectors wouldn't
      match. Custom properties still inherit into the injected DOM. This is only
      loaded on /search, so it doesn't leak elsewhere. */
  }
  <style is:global>
    #search {
      --pagefind-ui-scale: 1;
      --pagefind-ui-primary: var(--color-io-brand);
      --pagefind-ui-text: var(--color-io-onprimary);
      --pagefind-ui-background: var(--color-io-primary);
      --pagefind-ui-border: var(--color-io-gray-600);
      --pagefind-ui-tag: var(--color-io-secondary);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 4px;
      --pagefind-ui-font: var(--font-sans), system-ui, sans-serif;
    }
    /* The site's aggressive `section a` link styling doesn't reach here (this
       page isn't a .section), so Pagefind's own link styles stay intact. */
  </style>
</Layout>
