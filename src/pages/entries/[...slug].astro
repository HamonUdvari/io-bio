---
import Layout from "@layouts/Layout.astro";
import EntryArticle from "@components/EntryArticle.astro";
import RetiredEntryPage from "@components/RetiredEntry.astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import {
  readProductionDoiMap,
  retiredEntries,
  type RetiredEntry,
} from "@utils/retiredEntries";

export async function getStaticPaths() {
  const bios = await getCollection("bios");

  const entryPaths = bios.map((page) => {
    const { id } = page;

    return {
      params: { slug: id },
      props: { ...page },
    };
  });

  // An entry withdrawn after it received a permanent (production) Zenodo DOI
  // keeps a "withdrawn" tombstone at its old URL — the DOI record links here as
  // the canonical entry (see src/utils/retiredEntries.ts). Matched against the
  // real collection ids, so a tombstone never takes over a live entry's URL.
  const ids = new Set(bios.map((page) => page.id));
  const retiredPaths = retiredEntries(readProductionDoiMap(), ids).map(
    (retired) => ({ params: { slug: retired.slug }, props: { retired } }),
  );

  return [...entryPaths, ...retiredPaths];
}

// Set only on a withdrawn entry's tombstone; undefined for a live entry.
const retired = (Astro.props as { retired?: RetiredEntry }).retired;
const { data } = Astro.props;

const title = retired
  ? `${retired.title ?? "Withdrawn entry"} (withdrawn)`
  : `${data.lastName.toUpperCase()}, ${data.firstName}`;
const description = retired
  ? "This entry has been withdrawn from IO BIO."
  : data.summary;
const { Content } = retired ? { Content: null } : await render(Astro.props);

const slug = Astro.params.slug ?? Astro.props.id;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Pre-rendered entry PDF (generated by scripts/zenodo-render-pdfs.ts) served as
// a static asset alongside the entry; the Download button links here.
const pdfHref = `${base}entries/${slug}.pdf`;
// Live Paged.js print preview (the design surface; also what the PDF is rendered
// from) — the debug link opens it.
const printHref = `${base}print/${slug}`;
---

{
  retired && (
    <Layout title={title} description={description} noindex>
      <RetiredEntryPage entry={retired} />
    </Layout>
  )
}
{
  !retired && (
    <Layout title={title} description={description}>
      <EntryArticle data={data} Content={Content}>
        <div
          slot="controls"
          class="flex flex-col items-center gap-y-3 print:hidden"
        >
          <a
            class="button button--primary button--download"
            href={pdfHref}
            download={`${slug}-iobio.pdf`}
            >Download (PDF)</a
          >
          {/* Debug link (screen only), off: the live browser-print view for
              iterating on print styles. To use it, restore:
              <div class="flex flex-row gap-x-4 text-small">
                <a class="cursor-pointer underline opacity-70 hover:opacity-100"
                   href={printHref}>Print preview</a>
              </div> */}
        </div>
      </EntryArticle>
    </Layout>
  )
}
