---
// The printable entry "article" — shared by the on-site entry page
// (src/pages/entries/[...slug].astro) and the Paged.js print route
// (src/pages/print/[slug].astro), so the two never drift. Page-specific
// chrome (Layout, download/debug controls) stays out: the entry page injects
// its controls via the `controls` named slot; the print route injects nothing.
import Image from "@components/Image.astro";
import { aliasSuffix } from "@utils/displayName";
import { parseImageSource } from "@utils/imageSource";
// The "How to cite" editors credit now comes from each entry's OWN Word file
// (its "How to cite" line, parsed in docxLoader → data.editors), so entries can
// differ. `citation.editors` is the CMS-editable DEFAULT, used only when an
// entry's docx lacks the segment; then a hardcoded default as a last resort.
import { frontmatter as citation } from "@content/globals/citation.md";

// Rights/colophon footnote — site-wide, CMS-editable (Site text → Rights notice).
// Stored as markdown so the license link stays editable; rendered here. Falls
// back to the default wording if blank. Keep in sync with RIGHTS_NOTE in
// scripts/zenodo-mint.ts (the Zenodo record's `notes`).
import { marked } from "marked";
import { frontmatter as rights } from "@content/globals/rights.md";
const DEFAULT_RIGHTS =
  "Text © the author(s) and IO BIO, licensed under [CC BY-NC-ND 4.0](https://creativecommons.org/licenses/by-nc-nd/4.0/). The portrait is excluded and remains under the rights of its credited source. We have tried to trace the rights holder to obtain permission for the use of the portrait, but contact us in case we have failed.";
const rightsHtml = (
  marked.parse((rights.notice || "").trim() || DEFAULT_RIGHTS) as string
).replace(
  // keep external links opening in a new tab (marked doesn't add target/rel)
  /<a href="(https?:[^"]+)"/g,
  '<a href="$1" target="_blank" rel="noopener noreferrer"',
);

interface Props {
  data: Record<string, any>;
  Content: any;
}
const { data, Content } = Astro.props;

const {
  image,
  lastName,
  firstName,
  knownAs,
  nee,
  archives,
  publications,
  literature,
  imageSource,
  summary,
  authors,
  editors,
  version,
  imageFn,
  life,
  introNotes,
} = data;

// Prefer the entry's own editors; else the CMS default; else a hardcoded default.
const entryEditors = (editors || "").trim();
const editorsCredit = entryEditors
  ? `edited by ${entryEditors}`
  : citation.editors ||
    "edited by Bob Reinalda, Kent J. Kille and Jaci L. Eisenberg";

if (!image) {
  throw new Error("Image was missing");
}

const title = `${lastName.toUpperCase()}, ${firstName}`;
// Visible heading appends a parenthetical alias: the "(known as)" nickname when
// present, otherwise the "(née maiden-name)" — suppressed when it just repeats
// the name. The meta title + image alt keep the formal name (`title`).
const displayName = `${title}${aliasSuffix(knownAs, `${firstName} ${lastName}`, nee)}`;

// --- How to cite ----------------------------------------------------------
// Per-entry Zenodo citation (issue #2), built in docxLoader. It points to the
// entry's OWN up-to-date Zenodo record: a production DOI via doi.org once
// minted, else — for the current client preview — the sandbox deposit's concept
// record (always-latest version) on sandbox.zenodo.org. Null when the entry has
// no per-entry deposit, in which case only the URL "accessed on" citation shows
// (the whole-dictionary DOI is intentionally never shown as an entry citation —
// it confuses casual readers).
const zenodoCite = data.zenodoCite ?? null;

// Image credit: parsed into a short clickable host label + full URL (see
// @utils/imageSource). The same parser is used by the image-source CSV export.
const source = parseImageSource(imageSource);
---

{
  /* Transparent wrapper (`display:contents` generates no box, so the entry
    sections lay out exactly as before). Search indexing is handled separately by
    the build-time endpoint (src/pages/search-index.json.ts), not the DOM. */
}
<div id="entry-content" style="display: contents">
  <section class="bio-header">
    <figure class="figure">
      <picture>
        <Image class="w-full" imagePath={imageFn} alt={title} />
      </picture>
      <figcaption class="figure__credit">
        Source:{" "}
        {!source.href && imageSource}
        {
          source.href && (
            <>
              {source.text && <>{source.text} </>}
              <a
                href={source.href}
                class="source-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.label}
              </a>
            </>
          )
        }
      </figcaption>
    </figure>
    <div class="flex flex-col gap-y-2 leading-none">
      <h1 class="text-h2 leading-none">{displayName}</h1>
      <h2 class="text-h2 max-w-[45ch] mx-auto leading-none">{summary}</h2>
    </div>
    <p>By <strong>{authors}</strong> · {version}</p>
    <p class="text-balance">{life}</p>
    {introNotes?.map((note) => <p class="text-balance">{note}</p>)}
    <slot name="controls" />
  </section>
  <section id="biography">
    <h2 class="section__title">Biography</h2>
    <Content />
  </section>
  {
    archives?.items?.length > 0 && (
      <section id="archives">
        <h2 class="section__title">Archives</h2>
        {archives.items.length === 1 ? (
          <p>{archives.items[0].raw}</p>
        ) : (
          <ul>
            {archives.items.map((c) => (
              <li>{c.raw}</li>
            ))}
          </ul>
        )}
        {archives.websitesAccessedOn && (
          <p class="text-sm opacity-70">
            (all websites accessed {archives.websitesAccessedOn})
          </p>
        )}
      </section>
    )
  }
  {
    publications?.items?.length > 0 && (
      <section id="publications">
        <h2 class="section__title">Publications</h2>
        {publications.items.length === 1 ? (
          <p>{publications.items[0].raw}</p>
        ) : (
          <ul>
            {publications.items.map((c) => (
              <li>{c.raw}</li>
            ))}
          </ul>
        )}
        {publications.websitesAccessedOn && (
          <p class="text-sm opacity-70">
            (all websites accessed {publications.websitesAccessedOn})
          </p>
        )}
      </section>
    )
  }
  {
    literature?.items?.length > 0 && (
      <section id="literature">
        <h2 class="section__title">Literature</h2>
        {literature.items.length === 1 ? (
          <p>{literature.items[0].raw}</p>
        ) : (
          <ul>
            {literature.items.map((c) => (
              <li>{c.raw}</li>
            ))}
          </ul>
        )}
        {literature.websitesAccessedOn && (
          <p class="text-sm opacity-70">
            (all websites accessed {literature.websitesAccessedOn})
          </p>
        )}
      </section>
    )
  }
  <section id="cite">
    <h2 class="section__title">How to cite</h2>

    {
      zenodoCite && (
        <p>
          {authors}, '{lastName}, {firstName}' in{" "}
          <cite>
            IO BIO, Biographical Dictionary of Secretaries-General of
            International Organizations
          </cite>
          , {editorsCredit}. <a href={zenodoCite.url}>{zenodoCite.url}</a>
          {zenodoCite.sandbox && (
            <span class="text-small opacity-70"> (sandbox preview)</span>
          )}
        </p>
      )
    }
    {
      /* Rights/colophon footnote — CMS-editable (Site text → Rights notice),
        rendered from markdown. Keep in sync with RIGHTS_NOTE in
        scripts/zenodo-mint.ts (the Zenodo record's `notes`). */
    }
    <div class="text-small opacity-70" set:html={rightsHtml} />
  </section>
</div>
