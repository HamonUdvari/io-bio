---
import { getCollection } from "astro:content";

const pages = await getCollection("pages");
let links = pages
  .filter(({ data }) => !data.hideFromNav)
  .map(({ data }) => ({
    slug: data.slug,
    title: data.navLabel ?? data.title,
    order: data.order,
  }));
links = links.toSorted((a, b) => a.order - b.order);

// Normalise BASE_URL to exactly one trailing slash (it may be "/io-bio",
// "/io-bio/", or "/") so `${BASE}${slug}` always joins with a single slash.
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<nav class="nav flex flex-row">
  {
    links &&
      links.map(({ slug, title }) => <a href={`${BASE}${slug}`}>{title}</a>)
  }
  {
    /* PREVIEW: temporary entry point for the full-text search page. `ml-auto`
      right-aligns it as a standalone action. Remove or fold into the normal
      nav once the final search UI is decided. */
  }
  <a href={`${BASE}search`} class="ml-auto">Search</a>
</nav>
