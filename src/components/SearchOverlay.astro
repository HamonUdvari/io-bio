---
// Global full-text search overlay — headless Fuse.js behind our own overlay UI.
// ----------------------------------------------------------------------------
// Single home for ALL search concerns: the overlay dialog, the results render,
// the on-landing highlighter, and the red theming. Rendered once by Layout.astro
// so search works from every page — opened via the nav [data-search-trigger]
// button. Uses a native <dialog> (showModal) for free top-layer stacking,
// ::backdrop, Esc-to-close and focus handling.
//
// The index is a static JSON asset produced at build by
// src/pages/search-index.json.ts (prerendered → also served in `astro dev`, so
// search works in dev without a full build). We fetch it lazily on first open,
// run Fuse.js in the browser, and render results into #search with our own
// markup. Precision: a quoted "phrase" is an exact/literal filter; unquoted terms
// use Fuse's ranked matching (typo-tolerant for names). No stemming, no query
// backtracking — full control, unlike Pagefind.
---

<dialog class="search-overlay" aria-label="Search the biographies">
  <div
    class="search-overlay__panel scrollbar-thumb-white scrollbar-track-transparent"
  >
    <button
      type="button"
      class="search-overlay__close"
      data-search-close
      aria-label="Close search"
    >
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
    {/* Quoted phrases match literally; surfaced so users get precise results. */}
    <p class="search-overlay__hint">
      Tip: put an exact phrase in <strong>"quotes"</strong> for precise results.
    </p>
    <div id="search" class="search">
      <form class="search__form" role="search" onsubmit="return false">
        <span class="material-symbols-outlined search__icon" aria-hidden="true"
          >search</span
        >
        <input
          class="search__input"
          type="text"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="Search"
          aria-label="Search the biographies"
        />
        <button
          type="button"
          class="search__clear"
          data-search-clear
          aria-label="Clear search"
          hidden
        >
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </form>
      <p class="search__count" aria-live="polite"></p>
      <ul class="search__results"></ul>
    </div>
  </div>
</dialog>

<script>
  // Base path (e.g. "/io-bio/") — one source of truth for the index fetch + URLs.
  const BASE = import.meta.env.BASE_URL.replace(/\/?$/, "/");

  const MAP: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => MAP[c]);
  const escRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  // Diacritic-insensitive folding (é→e) so "Hammarskjold" matches "Hammarskjöld"
  // and JS's ASCII-only `\b` sees a boundary before accented words.
  const fold = (s: string) =>
    s.normalize("NFD").replace(/[̀-ͯ]/g, "");

  // Build an accent-insensitive regex source for a term, so a plain ASCII query
  // highlights the accented text ("hammarskjold" wraps "Hammarskjöld"). Each
  // base letter matches its accented variants; other chars stay literal.
  const ACCENTS: Record<string, string> = {
    a: "aàáâãäåāăą", c: "cçćč", e: "eèéêëēėę", g: "gğ",
    i: "iìíîïīį", l: "lł", n: "nñń", o: "oòóôõöøō", r: "rř",
    s: "sśš", t: "tť", u: "uùúûüũūů", y: "yýÿ", z: "zźżž",
  };
  function termToRe(term: string): string {
    return [...term]
      .map((ch) => {
        const set = ACCENTS[ch.toLowerCase()];
        return set ? `[${set}${set.toUpperCase()}]` : escRe(ch);
      })
      .join("");
  }

  // Parse a query into exact phrases ("...") + individual words (>= 2 chars).
  // A stray/open quote is dropped (so mid-typing a phrase still matches). Longer
  // terms first so a phrase wins over its component words when wrapping.
  function parseTerms(q: string): string[] {
    const phrases = [...q.matchAll(/"([^"]+)"/g)].map((m) => m[1].trim());
    const rest = q.replace(/"[^"]*"/g, " ").replace(/"/g, " ");
    const words = rest.split(/\s+/).filter((w) => w.length >= 2);
    const seen = new Set<string>();
    return [...phrases, ...words]
      .map((t) => t.toLowerCase())
      .filter((t) => t && !seen.has(t) && seen.add(t))
      .sort((a, b) => b.length - a.length);
  }

  // Wrap term occurrences in <mark> at a word boundary (so "for" doesn't
  // highlight inside "California"), escaping everything else.
  function highlight(text: string, terms: string[]): string {
    if (!terms.length) return esc(text);
    const re = new RegExp("\\b(" + terms.map(termToRe).join("|") + ")", "gi");
    let out = "";
    let last = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(text))) {
      out += esc(text.slice(last, m.index)) + "<mark>" + esc(m[0]) + "</mark>";
      last = m.index + m[0].length;
      if (m.index === re.lastIndex) re.lastIndex++;
    }
    return out + esc(text.slice(last));
  }

  type Doc = {
    slug: string;
    title: string;
    summary: string;
    life: string;
    nationality: string;
    authors: string;
    roles: { title: string; organisation: string; abbreviation: string }[];
    body: string;
    _text?: string; // lowercased combined text, for exact-phrase filtering
    _fields?: [string, number][]; // [lowercased field text, weight] for ranking
  };

  // Precision matcher: every query word must match a field at a WORD BOUNDARY
  // (prefix), so "ILO" hits "(ILO)" but not "pilot", and "underprivileged" hits
  // only itself, not "under". Quoted phrases must appear literally. Returns a
  // relevance score (sum of matched field weights) or null when it doesn't match.
  function matchDoc(doc: Doc, phrases: string[], words: string[]): number | null {
    let score = 0;
    for (const w of words) {
      const re = new RegExp("\\b" + escRe(w), "i");
      let best = 0;
      for (const [text, weight] of doc._fields || [])
        if (re.test(text)) best = Math.max(best, weight);
      if (best === 0) return null; // a query word matched nothing → drop
      score += best;
    }
    for (const p of phrases) {
      if (!(doc._text || "").includes(p)) return null;
      score += 3;
    }
    return score;
  }

  // A short excerpt around the first matched term, with matches highlighted.
  function excerpt(doc: Doc, terms: string[]): string {
    const text =
      doc.body && doc.body.trim()
        ? doc.body
        : `${doc.summary || ""} ${doc.life || ""}`.trim();
    if (!text) return "";
    if (terms.length) {
      // Accent-insensitive find of the first matched term (word boundary).
      const re = new RegExp("\\b(" + terms.map(termToRe).join("|") + ")", "i");
      const m = re.exec(text);
      if (m) {
        const idx = m.index;
        const start = Math.max(0, idx - 60);
        const end = Math.min(text.length, idx + 140);
        const snip =
          (start > 0 ? "…" : "") +
          text.slice(start, end) +
          (end < text.length ? "…" : "");
        return highlight(snip, terms);
      }
    }
    const head = text.slice(0, 160) + (text.length > 160 ? "…" : "");
    return highlight(head, terms);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const dlg = document.querySelector<HTMLDialogElement>(".search-overlay");

    // --- On-landing highlighter (runs on every page) -----------------------
    // A result links to `entries/<slug>/?highlight=<query>`; wrap matches in the
    // page's main content and scroll the first into view. Replaces Pagefind's
    // pagefind-highlight.js; the scroll-poll wrapper is kept from the old code.
    const hp = new URLSearchParams(location.search).get("highlight");
    if (hp) {
      const terms = parseTerms(hp);
      const scope =
        document.getElementById("entry-content") ||
        document.querySelector("main") ||
        document.body;
      if (terms.length && scope) {
        const re = new RegExp("\\b(" + terms.map(termToRe).join("|") + ")", "gi");
        const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT, {
          acceptNode(n) {
            const v = n.nodeValue;
            const p = n.parentNode as HTMLElement | null;
            if (!v || !v.trim() || !p) return NodeFilter.FILTER_REJECT;
            const tag = p.nodeName;
            if (tag === "SCRIPT" || tag === "STYLE" || tag === "MARK")
              return NodeFilter.FILTER_REJECT;
            return terms.some((t) => v.toLowerCase().includes(t))
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });
        const nodes: Text[] = [];
        let tn: Node | null;
        while ((tn = walker.nextNode())) nodes.push(tn as Text);
        for (const node of nodes) {
          const text = node.nodeValue as string;
          const frag = document.createDocumentFragment();
          let last = 0;
          let m: RegExpExecArray | null;
          re.lastIndex = 0;
          while ((m = re.exec(text))) {
            if (m.index > last)
              frag.appendChild(
                document.createTextNode(text.slice(last, m.index)),
              );
            const mark = document.createElement("mark");
            mark.className = "search-highlight";
            mark.textContent = m[0];
            frag.appendChild(mark);
            last = m.index + m[0].length;
            if (m.index === re.lastIndex) re.lastIndex++;
          }
          if (last < text.length)
            frag.appendChild(document.createTextNode(text.slice(last)));
          node.parentNode?.replaceChild(frag, node);
        }
        // Bring the first match into view; wait for `load` (late portrait shifts
        // layout) and poll briefly. `behavior:instant` beats the global smooth.
        const run = () => {
          const el = document.querySelector(".search-highlight");
          if (el)
            (el as HTMLElement).scrollIntoView({
              block: "center",
              behavior: "instant" as ScrollBehavior,
            });
        };
        if (document.readyState === "complete") run();
        else window.addEventListener("load", run, { once: true });
      }
    }

    if (!dlg) return;

    // --- Overlay open/close ------------------------------------------------
    const input = dlg.querySelector<HTMLInputElement>(".search__input");
    const clearBtn = dlg.querySelector<HTMLButtonElement>("[data-search-clear]");
    const countEl = dlg.querySelector<HTMLParagraphElement>(".search__count");
    const list = dlg.querySelector<HTMLUListElement>(".search__results");

    let ready = false;
    let docs: Doc[] = [];
    let loading = false;

    async function ensureIndex() {
      if (ready || loading) return;
      loading = true;
      try {
        const res = await fetch(`${BASE}search-index.json`);
        docs = (await res.json()) as Doc[];
        for (const d of docs) {
          const roles = d.roles || [];
          // Weighted fields for ranking + word-boundary matching, folded +
          // lowercased so matching is case- and accent-insensitive.
          d._fields = [
            [d.title, 3],
            [roles.map((r) => r.abbreviation).join(" "), 3],
            [roles.map((r) => r.organisation).join(" "), 2],
            [roles.map((r) => r.title).join(" "), 1.5],
            [d.summary, 2],
            [d.nationality, 1],
            [d.authors, 1],
            [`${d.life} ${d.body}`, 1],
          ].map(([t, w]) => [fold(String(t || "").toLowerCase()), w as number]);
          d._text = d._fields.map(([t]) => t).join(" ");
        }
        ready = true;
        render(input?.value ?? ""); // re-render once the index has loaded
      } catch {
        /* leave not-ready — render() shows an empty state */
      } finally {
        loading = false;
      }
    }

    function render(q: string) {
      if (!list || !countEl) return;
      const query = q.trim();
      if (clearBtn) clearBtn.hidden = query === "";
      if (!query) {
        list.innerHTML = "";
        countEl.textContent = "";
        return;
      }
      const terms = parseTerms(query); // for <mark> highlighting (as typed)
      // Folded phrases + words for matching. A stray/open quote is dropped so
      // mid-typing a phrase (e.g. `"Bank for`) still returns results, and the
      // matcher is precise: no fuzzy fallback → an absent term gives 0 results.
      const phrases = [...query.matchAll(/"([^"]+)"/g)]
        .map((m) => fold(m[1].trim().toLowerCase()))
        .filter(Boolean);
      const words = query
        .replace(/"[^"]*"/g, " ")
        .replace(/"/g, " ")
        .split(/\s+/)
        .map((w) => fold(w.toLowerCase()))
        .filter((w) => w.length >= 2);

      let hits: Doc[] = [];
      if (phrases.length || words.length) {
        hits = docs
          .map((d) => ({ d, s: matchDoc(d, phrases, words) }))
          .filter((r) => r.s !== null)
          .sort(
            (a, b) =>
              (b.s as number) - (a.s as number) ||
              a.d.title.localeCompare(b.d.title),
          )
          .map((r) => r.d);
      }

      countEl.textContent = `${hits.length} result${hits.length === 1 ? "" : "s"} for ${query}`;
      const hl = `?highlight=${encodeURIComponent(query)}`;
      list.innerHTML = hits
        .slice(0, 50)
        .map(
          (d) => `
        <li class="search__result">
          <a class="search__result-link" href="${BASE}entries/${d.slug}/${hl}">${highlight(d.title, terms)}</a>
          <p class="search__excerpt">${excerpt(d, terms)}</p>
        </li>`,
        )
        .join("");
    }

    let t = 0;
    function onInput() {
      window.clearTimeout(t);
      t = window.setTimeout(() => render(input?.value ?? ""), 140);
    }
    input?.addEventListener("input", onInput);
    clearBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      render("");
      input?.focus();
    });

    function focusInput() {
      requestAnimationFrame(() => input?.focus());
    }
    function open() {
      ensureIndex(); // lazy — the index only loads on the first open
      if (!dlg!.open) dlg!.showModal();
      focusInput();
    }
    function close() {
      if (dlg!.open) dlg!.close();
    }

    document.querySelectorAll("[data-search-trigger]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        open();
      });
    });
    // Backdrop dismiss: close only when BOTH pointerdown and click land on the
    // dialog itself (outside the panel) — avoids the open-gesture closing it.
    let downOnBackdrop = false;
    dlg.addEventListener("pointerdown", (e) => {
      downOnBackdrop = e.target === dlg;
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg && downOnBackdrop) close();
      downOnBackdrop = false;
    });
    dlg.querySelector("[data-search-close]")?.addEventListener("click", close);
  });
</script>

<style is:global>
  /* ---- Overlay shell (unchanged from the Pagefind version) --------------- */
  .search-overlay {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .search-overlay::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .search-overlay__panel {
    position: relative;
    width: min(640px, 92vw);
    margin: 10vh auto 0;
    max-height: 80dvh;
    overflow: auto;
    padding: 1.5rem;
    background: var(--color-io-primary);
    color: var(--color-io-onprimary);
    border: 1px solid var(--color-io-gray-600);
    border-radius: 6px;
  }
  /* Close affordance hidden for now (per client). Esc + backdrop still dismiss. */
  .search-overlay__close {
    display: none;
  }
  .search-overlay__hint {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-io-onprimary);
    opacity: 0.6;
    text-align: center;
  }

  /* ---- Search input (matches the entries column-filter look) ------------- */
  /* `--si-lh` = the entries-filter line-height at the current breakpoint, so the
     box height mirrors `.entries__search` exactly: line-height + 2·--btn-py.
     Font is 16px until desktop (20px), matching --text-body. */
  .search__form {
    --si-lh: calc(var(--leading-body-base) * var(--text-body-base));
    position: relative;
    display: flex;
    align-items: center;
  }
  .search__icon {
    position: absolute;
    left: 0.75rem;
    font-size: 20px;
    opacity: 0.7;
    pointer-events: none;
  }
  .search__input {
    width: 100%;
    height: calc(var(--si-lh) + 2 * var(--btn-py));
    padding: 0 2.5rem;
    font-size: var(--text-body-base);
    line-height: var(--si-lh);
    font-weight: 400;
    font-family: var(--font-sans), system-ui, sans-serif;
    color: var(--color-io-onprimary);
    background: transparent;
    border: 1px solid var(--color-io-gray-600);
    border-radius: 0; /* sharp corners, like the entries filter */
    outline-offset: -2px;
  }
  .search__input::placeholder {
    color: var(--color-io-onprimary);
    opacity: 0.5;
  }
  .search__clear {
    position: absolute;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    color: var(--color-io-onprimary);
    opacity: 0.7;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .search__clear[hidden] {
    display: none;
  }
  .search__clear .material-symbols-outlined {
    font-size: 18px;
  }
  @media (min-width: 80rem) {
    .search__form {
      --si-lh: calc(var(--leading-body-desktop) * var(--text-body-desktop));
    }
    .search__input {
      font-size: var(--text-body-desktop);
    }
  }

  /* ---- Results ---------------------------------------------------------- */
  .search__count {
    margin: 1rem 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-io-onprimary);
  }
  .search__count:empty {
    display: none;
  }
  .search__results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Whole card clickable via the title link's stretched ::after. Stays a real
     anchor, so keyboard focus + cmd/middle-click "open in new tab" keep working. */
  .search__result {
    position: relative;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-io-gray-600);
  }
  .search__result:first-child {
    border-top: 0;
  }
  .search__result-link {
    color: var(--color-io-onprimary);
    font-weight: 700;
    text-decoration: none;
  }
  .search__result-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .search__excerpt {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-io-onprimary);
    opacity: 0.75;
  }

  /* Matched-term highlight → site red (results + on-landing). */
  .search mark,
  .search-highlight {
    background-color: var(--color-io-red);
    color: var(--color-io-onbrand);
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .search-highlight {
    scroll-margin-top: 2rem;
  }
</style>
