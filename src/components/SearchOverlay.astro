---
// PREVIEW — global full-text search overlay (Pagefind).
// ----------------------------------------------------------------------------
// Single home for ALL Pagefind concerns: the overlay dialog, Pagefind's default
// UI, the on-landing highlighter, and the red theming. Rendered once by
// Layout.astro, so search works from every page — opened via the nav
// [data-search-trigger] button. Uses a native <dialog> (showModal) for free
// top-layer stacking, ::backdrop, Esc-to-close and focus handling.
//
// The index + UI bundle (dist/pagefind/*) are produced AFTER `astro build` by
// the Pagefind CLI (see `build:search` in package.json + the deploy.yml step),
// so search is inert under `astro dev`. Test locally with:
//     pnpm run build:search && pnpm run preview
//
// Still a preview UI to react to — swapping this modal for a nav-embedded
// dropdown later would touch only this file + the nav trigger.
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

{/* Pagefind's default-UI stylesheet, served from the built bundle. */}
<link rel="stylesheet" href={`${BASE}pagefind/pagefind-ui.css`} />

<dialog class="search-overlay" aria-label="Search the biographies">
  <div class="search-overlay__panel">
    <button
      type="button"
      class="search-overlay__close"
      data-search-close
      aria-label="Close search"
    >
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
    {/* Pagefind injects the search box + results inside this container. */}
    <div id="search"></div>
  </div>
</dialog>

{
  /* Default-UI bundle (a classic script that sets window.PagefindUI). `is:inline`
    so Astro leaves it untouched — generated post-build under `${BASE}pagefind/`. */
}
<script is:inline defer src={`${BASE}pagefind/pagefind-ui.js`}></script>

{
  /* On-landing highlighter. pagefind-highlight.js is an ES MODULE and does NOT
    auto-run, so import + instantiate it. Loaded only when arriving from a result
    (the ?pagefind-highlight param is present), so other pages never fetch it.
    The constructor reads the param, wraps matches in <mark class="pagefind-highlight">;
    we then scroll the first match into view. */
}
<script type="module" is:inline define:vars={{ base: BASE }}>
  if (location.search.indexOf("pagefind-highlight") !== -1) {
    import(`${base}pagefind/pagefind-highlight.js`)
      .then((m) => {
        const PH = m.PagefindHighlight || window.PagefindHighlight;
        if (!PH) return;
        new PH();
        // pagefind-highlight has no scroll option, so bring the first match into
        // view ourselves. Wait for window `load` first: the large portrait loads
        // late and would otherwise shift the target out from under the scroll.
        // mark.js wraps asynchronously, so poll briefly for the first highlight.
        const run = () => {
          let tries = 0;
          const poll = () => {
            const el = document.querySelector(".pagefind-highlight");
            // `behavior: instant` overrides the site's global
            // `scroll-behavior: smooth`, whose animated scroll gets interrupted
            // by late layout shifts and never lands on the match.
            if (el) el.scrollIntoView({ block: "center", behavior: "instant" });
            else if (tries++ < 40) setTimeout(poll, 50);
          };
          poll();
        };
        if (document.readyState === "complete") run();
        else window.addEventListener("load", run, { once: true });
      })
      .catch(() => {});
  }
</script>

<script is:inline define:vars={{ base: BASE }}>
  (function () {
    function ready(fn) {
      if (document.readyState !== "loading") fn();
      else document.addEventListener("DOMContentLoaded", fn);
    }
    ready(function () {
      var dlg = document.querySelector(".search-overlay");
      if (!dlg) return;
      var pfui = null;

      // Pagefind records URLs relative to the indexed dist/ root
      // (e.g. "/entries/<slug>/"); the site is served under `base`, so prefix.
      function prefixBase(u) {
        if (!u) return u;
        if (base === "/" || u.indexOf(base) === 0) return u;
        return base.replace(/\/$/, "") + u;
      }
      function currentQuery() {
        var i = dlg.querySelector(".pagefind-ui__search-input");
        return i && i.value ? i.value.trim() : "";
      }
      // Append ?pagefind-highlight=<query> so the landing page highlights the
      // matched word (manual stand-in — the default UI has no highlightParam).
      // Inserted before any #anchor so sub-result fragments still work.
      function withHighlight(u) {
        u = prefixBase(u);
        var q = currentQuery();
        if (!u || !q) return u;
        var param = "pagefind-highlight=" + encodeURIComponent(q);
        var h = u.indexOf("#");
        var hash = h >= 0 ? u.slice(h) : "";
        var pq = h >= 0 ? u.slice(0, h) : u;
        pq += (pq.indexOf("?") >= 0 ? "&" : "?") + param;
        return pq + hash;
      }

      function focusInput() {
        var i = dlg.querySelector(".pagefind-ui__search-input");
        if (i) i.focus();
      }
      function init() {
        if (pfui) return;
        // The default-UI bundle loads deferred — if a very fast click beats it,
        // retry until it's ready rather than mounting nothing.
        if (typeof PagefindUI === "undefined") {
          setTimeout(init, 60);
          return;
        }
        pfui = new PagefindUI({
          element: "#search",
          bundlePath: base + "pagefind/",
          showSubResults: true,
          showImages: false,
          processResult: function (r) {
            if (r.url) r.url = withHighlight(r.url);
            if (Array.isArray(r.sub_results)) {
              r.sub_results.forEach(function (s) {
                if (s.url) s.url = withHighlight(s.url);
              });
            }
            return r;
          },
        });
        requestAnimationFrame(focusInput);
      }

      function open() {
        init(); // lazy — index chunks stay unloaded until the first search
        if (!dlg.open) dlg.showModal();
        requestAnimationFrame(focusInput);
      }
      function close() {
        if (dlg.open) dlg.close();
      }

      document.querySelectorAll("[data-search-trigger]").forEach(function (t) {
        t.addEventListener("click", function (e) {
          e.preventDefault();
          open();
        });
      });
      // Backdrop dismiss: close only when BOTH pointerdown and click land on the
      // dialog itself (outside the panel). Requiring pointerdown-on-backdrop
      // avoids the classic race where the same gesture that opens the modal
      // closes it as the modal appears mid-click. Esc is native to <dialog>.
      var downOnBackdrop = false;
      dlg.addEventListener("pointerdown", function (e) {
        downOnBackdrop = e.target === dlg;
      });
      dlg.addEventListener("click", function (e) {
        if (e.target === dlg && downOnBackdrop) close();
        downOnBackdrop = false;
      });
      var c = dlg.querySelector("[data-search-close]");
      if (c) c.addEventListener("click", close);
    });
  })();
</script>

<style is:global>
  /* Theme Pagefind's injected UI to the dark site — custom properties inherit
     into the runtime-injected DOM, so a plain #search selector is enough. */
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-io-brand);
    --pagefind-ui-text: var(--color-io-onprimary);
    --pagefind-ui-background: var(--color-io-primary);
    --pagefind-ui-border: var(--color-io-gray-600);
    --pagefind-ui-tag: var(--color-io-secondary);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: var(--font-sans), system-ui, sans-serif;
  }

  /* Overlay: a native <dialog> filling the viewport so backdrop clicks close it;
     the inner panel holds the search UI near the top. */
  .search-overlay {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .search-overlay::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .search-overlay__panel {
    position: relative;
    width: min(640px, 92vw);
    margin: 10vh auto 0;
    max-height: 80dvh;
    overflow: auto;
    padding: 1.5rem;
    background: var(--color-io-primary);
    color: var(--color-io-onprimary);
    border: 1px solid var(--color-io-gray-600);
    border-radius: 6px;
  }
  .search-overlay__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-io-onprimary);
    line-height: 1;
  }
  .search-overlay__close:hover {
    color: var(--text-hover);
  }

  /* Point 3 — recolor the matched-term highlight to the site red.
     The default UI resets <mark> via `.pagefind-ui--reset mark { all: revert }`
     (browser-default yellow). The Pagefind <link> loads AFTER this hoisted style,
     so match on equal specificity would lose — `#search` (id) outranks it
     regardless of source order. */
  #search mark {
    background-color: var(--color-io-red);
    color: var(--color-io-onbrand);
    padding: 0 0.1em;
    border-radius: 2px;
  }
  /* On-landing highlight: pagefind-highlight.js injects a zero-specificity
     `:where(.pagefind-highlight)` yellow default — easily overridden here. */
  .pagefind-highlight {
    background-color: var(--color-io-red);
    color: var(--color-io-onbrand);
    scroll-margin-top: 2rem;
  }
</style>
